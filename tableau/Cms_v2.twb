      <aliases enabled='yes' />
      <column caption='Payment Per discharge' datatype='real' name='[Calculation_2482207000928256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([total_medicare_payment_amount])/SUM([total_discharges]), 2)' />
      </column>
      <column caption='Natioanl Avg Payment' datatype='real' name='[Calculation_2482207012777985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([total_medicare_payment_amount])) /&#13;&#10;WINDOW_SUM(SUM([total_discharges]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='State Avg Payment' datatype='real' name='[Calculation_2482207013937154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [provider_state] : &#13;&#10;    SUM([total_medicare_payment_amount]) / SUM([total_discharges])&#13;&#10;}' />
      </column>
