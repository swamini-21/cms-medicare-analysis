      <column caption='Gender Share' datatype='real' name='[Age Share (copy)_1952791066431503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([Bene_Count (dim_gender)])/SUM([Total_Bene]), 2)' />
      </column>
      <column caption='Age Group' datatype='string' name='[Age_Group]' role='dimension' type='nominal' />
      <column caption='Bene Avg Age' datatype='real' name='[Bene_Avg_Age]' role='measure' type='quantitative' />
      <column caption='Bene Avg Risk Score' datatype='real' name='[Bene_Avg_Risk_Score]' role='measure' type='quantitative' />
      <column caption='Bene Count (dim age)' datatype='real' name='[Bene_Count (dim_age)]' role='measure' type='quantitative' />
      <column caption='Bene Count (dim gender)' datatype='real' name='[Bene_Count (dim_gender)]' role='measure' type='quantitative' />
