                <zone h='9636' id='22' name='Behavioral health' pane-specification-id='2' param='[federated.08yb1ib0r4lqav1fpgbsl0m72mwi].[none:dual_tier:nk]' type-v2='color' w='9370' x='89971' y='28385'>
                  <zone-style>
                    <format attr='border-color' value='#b4b4b4' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
