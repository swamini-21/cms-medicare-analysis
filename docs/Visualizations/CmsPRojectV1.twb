    <worksheet name='Comorbidity Tier'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Comorbidity Tier</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mv_financial_performance+ (cms_project)' name='federated.08yb1ib0r4lqav1fpgbsl0m72mwi' />
          </datasources>
          <datasource-dependencies datasource='federated.08yb1ib0r4lqav1fpgbsl0m72mwi'>
            <column caption='Comorbidity Tier' datatype='string' name='[Calculation_1082530053156867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Comorbidity Tier&#13;&#10;IF [comorbidity_index] &lt; { FIXED : PERCENTILE([comorbidity_index], 0.33) }&#13;&#10;THEN &quot;Low&quot;&#13;&#10;ELSEIF [comorbidity_index] &lt; { FIXED : PERCENTILE([comorbidity_index], 0.66) }&#13;&#10;THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
            </column>
            <column caption='Payment Per Discharge' datatype='real' name='[Calculation_1952790990282754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([Total_Medicare_Payment_Amnt])/SUM([Total_Discharges]), 2)' />
            </column>
            <column caption='Provider State' datatype='string' name='[Provider_State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Total Discharges' datatype='integer' name='[Total_Discharges]' role='measure' type='quantitative' />
            <column caption='Total Medicare Payment Amnt' datatype='integer' name='[Total_Medicare_Payment_Amnt]' role='measure' type='quantitative' />
            <column caption='Comorbidity Index' datatype='real' name='[comorbidity_index]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1082530053156867]' derivation='None' name='[none:Calculation_1082530053156867:nk]' pivot='key' type='nominal' />
            <column-instance column='[Provider_State]' derivation='None' name='[none:Provider_State:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1952790990282754]' derivation='User' name='[usr:Calculation_1952790990282754:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.08yb1ib0r4lqav1fpgbsl0m72mwi].[none:Calculation_1082530053156867:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Low&quot;</bucket>
              <bucket>&quot;Medium&quot;</bucket>
              <bucket>&quot;High&quot;</bucket>
            </dictionary>
