    <worksheet name='Yield Analysis'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Yield Analysis</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mv_financial_performance+ (cms_project)' name='federated.08yb1ib0r4lqav1fpgbsl0m72mwi' />
          </datasources>
          <datasource-dependencies datasource='federated.08yb1ib0r4lqav1fpgbsl0m72mwi'>
            <column caption='Reimbursement_Rate' datatype='real' name='[Calculation_1311774354300928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total_Medicare_Payment_Amnt])/SUM([Total_Sub_Covered_Charges])*100' />
            </column>
            <column caption='National Avg Payment Per Bene' datatype='real' name='[Calculation_1311774356467713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(SUM([Total_Medicare_Payment_Amnt])) / WINDOW_SUM(SUM([Total_Bene]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Provider State' datatype='string' name='[Provider_State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
