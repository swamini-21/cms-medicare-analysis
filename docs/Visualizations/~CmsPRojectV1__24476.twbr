            <column caption='Comorbidity Index' datatype='real' name='[comorbidity_index]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1082530053156867]' derivation='None' name='[none:Calculation_1082530053156867:nk]' pivot='key' type='nominal' />
