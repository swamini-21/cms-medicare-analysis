            <column caption='Comorbidity Tier' datatype='string' name='[Calculation_1082530053156867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Comorbidity Tier&#13;&#10;IF [comorbidity_index] &lt; { FIXED : PERCENTILE([comorbidity_index], 0.33) }&#13;&#10;THEN &quot;Low&quot;&#13;&#10;ELSEIF [comorbidity_index] &lt; { FIXED : PERCENTILE([comorbidity_index], 0.66) }&#13;&#10;THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
            </column>
            <column caption='Payment Per Discharge' datatype='real' name='[Calculation_1952790990282754]' role='measure' type='quantitative'>
