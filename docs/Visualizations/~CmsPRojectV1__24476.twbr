      <aliases enabled='yes' />
      <column caption='Gender Share' datatype='real' name='[Age Share (copy)_1952791066431503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([Bene_Count (dim_gender)])/SUM([Total_Bene]), 2)' />
      </column>
      <column caption='Age Group' datatype='string' name='[Age_Group]' role='dimension' type='nominal' />
      <column caption='Low Minority State Payment' datatype='real' name='[Avg Payment-High Minority Share (copy)_2197708351639553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Low Minority Payment per Bene&#13;&#10;WINDOW_SUM(SUM(IF [Minority_Share] &lt; 0.5&#13;&#10;    THEN [Total_Medicare_Payment_Amnt] &#13;&#10;    ELSE 0 END))&#13;&#10;/&#13;&#10;WINDOW_SUM(SUM(IF [Minority_Share] &lt; 0.5&#13;&#10;    THEN [Total_Bene] &#13;&#10;    ELSE 0 END))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Bene Avg Age' datatype='real' name='[Bene_Avg_Age]' role='measure' type='quantitative' />
      <column caption='Bene Avg Risk Score' datatype='real' name='[Bene_Avg_Risk_Score]' role='measure' type='quantitative' />
      <column caption='Bene Count (dim age)' datatype='real' name='[Bene_Count (dim_age)]' role='measure' type='quantitative' />
      <column caption='Bene Count (dim gender)' datatype='real' name='[Bene_Count (dim_gender)]' role='measure' type='quantitative' />
      <column caption='Bene Count' datatype='real' name='[Bene_Count]' role='measure' type='quantitative' />
      <column caption='State Avg Payment' datatype='real' name='[Calculation_0584730313961472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// State Avg Payment per Discharge&#13;&#10;{ FIXED [Provider_State] : &#13;&#10;    SUM([Total_Medicare_Payment_Amnt]) / SUM([Total_Discharges])&#13;&#10;}' />
      </column>
      <column caption='Overpaid Residual' datatype='real' name='[Calculation_0746631679713280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [residual_label] = &quot;Overpaid&quot; &#13;&#10;    THEN [residual] &#13;&#10;    END)' />
      </column>
      <column caption='Underpaid Residual' datatype='real' name='[Calculation_0746631679811585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [residual_label] = &quot;Underpaid&quot; &#13;&#10;    THEN [residual] &#13;&#10;    END)' />
      </column>
      <column caption='R_Square_static value' datatype='real' name='[Calculation_0746631682596866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.0634' />
      </column>
      <column caption='High Dual Avg Payment per Discharge' datatype='real' name='[Calculation_0746631692079107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [dual_tier] = &quot;High Dual&quot; &#13;&#10;    THEN [Total_Medicare_Payment_Amnt] &#13;&#10;    ELSE 0 END)&#13;&#10;/&#13;&#10;SUM(IF [dual_tier] = &quot;High Dual&quot; &#13;&#10;    THEN [Total_Discharges] &#13;&#10;    ELSE 0 END)' />
      </column>
      <column caption='Low Dual Avg Payment per Discharge' datatype='real' name='[Calculation_0746631692161028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [dual_tier] = &quot;Low Dual&quot; &#13;&#10;    THEN [Total_Medicare_Payment_Amnt] &#13;&#10;    ELSE 0 END)&#13;&#10;/&#13;&#10;SUM(IF [dual_tier] = &quot;Low Dual&quot; &#13;&#10;    THEN [Total_Discharges] &#13;&#10;    ELSE 0 END)' />
      </column>
      <column caption='High Burden Hospital Count' datatype='integer' name='[Calculation_1082530017329153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1082530053156867] = &quot;High&quot;&#13;&#10;    THEN [Provider_CCN]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Comorbidity Tier' datatype='string' name='[Calculation_1082530053156867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Comorbidity Tier&#13;&#10;IF [comorbidity_index] &lt; { FIXED : PERCENTILE([comorbidity_index], 0.33) }&#13;&#10;THEN &quot;Low&quot;&#13;&#10;ELSEIF [comorbidity_index] &lt; { FIXED : PERCENTILE([comorbidity_index], 0.66) }&#13;&#10;THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Payment Gap (Low-High)' datatype='real' name='[Calculation_1082530130550788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS((SUM(IF [Calculation_1082530053156867] = &quot;High&quot; THEN [Total_Medicare_Payment_Amnt] ELSE 0 END)&#13;&#10;/SUM(IF [Calculation_1082530053156867] = &quot;High&quot; THEN [Total_Discharges]  ELSE 0 END)) - &#13;&#10;(SUM(IF [Calculation_1082530053156867] = &quot;Low&quot; THEN [Total_Medicare_Payment_Amnt] ELSE 0 END)&#13;&#10;/SUM(IF [Calculation_1082530053156867] = &quot;Low&quot; THEN [Total_Discharges]  ELSE 0 END)))' />
      </column>
      <column caption='Median_Markup_Ratio' datatype='real' name='[Calculation_1082530159325190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(MEDIAN([Total_Sub_Covered_Charges]/[Total_Medicare_Payment_Amnt]), 2)' />
      </column>
      <column caption='Max Markup Ratio' datatype='real' name='[Calculation_1082530160136199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(ROUND([Total_Sub_Covered_Charges]/[Total_Medicare_Payment_Amnt], 2))' />
      </column>
      <column caption='Markup above 10x' datatype='integer' name='[Calculation_1082530300739592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF ([Total_Sub_Covered_Charges]/[Total_Medicare_Payment_Amnt]) &gt; 10&#13;&#10;THEN [Provider_CCN]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='High Dual Avg Days Per Discharge' datatype='real' name='[Calculation_1117716232208384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [dual_tier] = &quot;High Dual&quot; &#13;&#10;    THEN [Total_Covered_Days] ELSE 0 END)&#13;&#10;/&#13;&#10;SUM(IF [dual_tier] = &quot;High Dual&quot; &#13;&#10;    THEN [Total_Discharges] ELSE 0 END)' />
      </column>
      <column caption='Low Dual Avg Days Per Discharge' datatype='real' name='[Calculation_1117716232540161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [dual_tier] = &quot;Low Dual&quot; &#13;&#10;    THEN [Total_Covered_Days] ELSE 0 END)&#13;&#10;/&#13;&#10;SUM(IF [dual_tier] = &quot;Low Dual&quot; &#13;&#10;    THEN [Total_Discharges] ELSE 0 END)' />
      </column>
      <column caption='Highest Minority State Payment' datatype='real' name='[Calculation_1167198859403264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// High Minority Payment per Bene&#13;&#10;WINDOW_SUM(SUM(IF [Minority_Share] &gt;=0.5 &#13;&#10;    THEN [Total_Medicare_Payment_Amnt] &#13;&#10;    ELSE 0 END))&#13;&#10;/&#13;&#10;WINDOW_SUM(SUM(IF [Minority_Share] &gt;=0.5 &#13;&#10;    THEN [Total_Bene] &#13;&#10;    ELSE 0 END))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_1167198863093761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Reimbursement_Rate' datatype='real' name='[Calculation_1311774354300928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Medicare_Payment_Amnt])/SUM([Total_Sub_Covered_Charges])*100' />
      </column>
      <column caption='National Avg Payment Per Bene' datatype='real' name='[Calculation_1311774356467713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([Total_Medicare_Payment_Amnt])) / WINDOW_SUM(SUM([Total_Bene]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='State Avg Residual' datatype='real' name='[Calculation_1540749134118912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Provider_State]:AVG([residual])}' />
      </column>
      <column caption='National_Avg_Payment/Discharge' datatype='real' name='[Calculation_1602053227446273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// KPI National Avg Payment per Discharge&#13;&#10;WINDOW_SUM(SUM([Total_Medicare_Payment_Amnt])) /&#13;&#10;WINDOW_SUM(SUM([Total_Discharges]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Days Per Discharge' datatype='real' name='[Calculation_1952790948323328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([Total_Covered_Days])/SUM([Total_Discharges]), 2)' />
      </column>
      <column caption='Payment Per Discharge' datatype='real' name='[Calculation_1952790990282754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([Total_Medicare_Payment_Amnt])/SUM([Total_Discharges]), 2)' />
      </column>
      <column caption='Payment Per Bene' datatype='real' name='[Calculation_1952790991777797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([Total_Medicare_Payment_Amnt])/SUM([Total_Bene]), 2)' />
      </column>
      <column caption='Markup Ratio' datatype='real' name='[Calculation_1952790992375815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([Total_Sub_Covered_Charges])/SUM([Total_Medicare_Payment_Amnt]), 2)' />
      </column>
      <column caption='Dual Share' datatype='real' name='[Calculation_1952790992572424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([Dual_Bene])/SUM([Total_Bene]), 2)' />
      </column>
      <column caption='Age Share' datatype='real' name='[Calculation_1952791052210188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(MIN(SUM([Bene_Count (dim_age)])/SUM([Total_Bene]), 1.0), 2)' />
      </column>
      <column caption='Oldest Old Share by state' datatype='real' name='[Calculation_1952791059595277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Provider_State] : &#13;&#10;    ROUND(SUM(IF [Age_Group] = &quot;GT_84&quot; THEN [Bene_Count (dim_age)] END) /&#13;&#10;    SUM([Bene_Count (dim_age)]), 2)&#13;&#10;}' />
      </column>
      <column caption='Female Share by State' datatype='real' name='[Calculation_1952791066034190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Provider_State] : &#13;&#10;  ROUND(SUM(IF [Gender] = &quot;Female&quot; THEN [Bene_Count (dim_gender)] END) /&#13;&#10;    SUM([Bene_Count (dim_gender)]), 2)&#13;&#10;}' />
      </column>
      <column caption='Avg Payment-High Minority Share' datatype='integer' name='[Calculation_2197708350156800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Minority_Share] &gt;= 0.5 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Avg Payment Highest Minority' datatype='integer' name='[Calculation_2197708360015878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='24495' />
      </column>
