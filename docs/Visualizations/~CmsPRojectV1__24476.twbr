    <worksheet name='Payment Gap (High/Low)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontsize='11'>Payment Gap (Low V/s High Burden)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mv_financial_performance+ (cms_project)' name='federated.08yb1ib0r4lqav1fpgbsl0m72mwi' />
          </datasources>
          <datasource-dependencies datasource='federated.08yb1ib0r4lqav1fpgbsl0m72mwi'>
            <column caption='Comorbidity Tier' datatype='string' name='[Calculation_1082530053156867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Comorbidity Tier&#13;&#10;IF [comorbidity_index] &lt; { FIXED : PERCENTILE([comorbidity_index], 0.33) }&#13;&#10;THEN &quot;Low&quot;&#13;&#10;ELSEIF [comorbidity_index] &lt; { FIXED : PERCENTILE([comorbidity_index], 0.66) }&#13;&#10;THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
            </column>
            <column caption='Payment Gap (Low-High)' datatype='real' name='[Calculation_1082530130550788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((SUM(IF [Calculation_1082530053156867] = &quot;High&quot; THEN [Total_Medicare_Payment_Amnt] ELSE 0 END)&#13;&#10;/SUM(IF [Calculation_1082530053156867] = &quot;High&quot; THEN [Total_Discharges]  ELSE 0 END)) - &#13;&#10;(SUM(IF [Calculation_1082530053156867] = &quot;Low&quot; THEN [Total_Medicare_Payment_Amnt] ELSE 0 END)&#13;&#10;/SUM(IF [Calculation_1082530053156867] = &quot;Low&quot; THEN [Total_Discharges]  ELSE 0 END)))' />
            </column>
            <column caption='Total Discharges' datatype='integer' name='[Total_Discharges]' role='measure' type='quantitative' />
            <column caption='Total Medicare Payment Amnt' datatype='integer' name='[Total_Medicare_Payment_Amnt]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[Year]' role='dimension' type='ordinal' />
            <column caption='Comorbidity Index' datatype='real' name='[comorbidity_index]' role='measure' type='quantitative' />
            <column-instance column='[Year]' derivation='None' name='[none:Year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1082530130550788]' derivation='User' name='[usr:Calculation_1082530130550788:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.08yb1ib0r4lqav1fpgbsl0m72mwi].[none:Year:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-align' value='center' />
            <format attr='text-format' field='[federated.08yb1ib0r4lqav1fpgbsl0m72mwi].[usr:Calculation_1082530130550788:qk]' value='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' />
          </style-rule>
